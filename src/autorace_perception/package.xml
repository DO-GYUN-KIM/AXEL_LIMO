<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autorace_perception</name>
  <version>0.1.0</version>
  <description>차선 검출, YOLO 표지판 검출, LiDAR 가공 노드입니다.</description>
  <maintainer email="team@example.com">autorace team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>autorace_interfaces</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- ultralytics는 rosdep 키가 없어 pip로 설치합니다. README를 참고하십시오. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
